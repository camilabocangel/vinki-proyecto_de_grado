# ============================================================
# Vinki — variables de producción (consumidas por docker-compose.prod.yml)
# Copiá a .env.prod en tu servidor y editá los valores.
# NO commitear .env.prod al repo.
# ============================================================

# Puertos expuestos al host: frontend 5189, backend 3089 (definidos en
# docker-compose.prod.yml; si querés cambiarlos editá ese archivo).

# --- URLs públicas (cambiá SU_IP_O_DOMINIO por el host real) ---
# El navegador del usuario llamará a estas URLs, así que deben ser
# accesibles desde fuera del servidor.
VITE_API_URL=http://SU_IP_O_DOMINIO:3089/api
FRONTEND_URL=http://SU_IP_O_DOMINIO:5189

# --- Postgres ---
POSTGRES_USER=vinki
POSTGRES_DB=vinki
POSTGRES_PASSWORD=CAMBIA_ESTO_password_largo_y_aleatorio

# --- MinIO (S3 compatible) ---
MINIO_ROOT_USER=vinki_minio
MINIO_ROOT_PASSWORD=CAMBIA_ESTO_minio_password_min_8_chars

# --- JWT (RS256) ---
# Generá un par nuevo en el servidor con:
#   openssl genpkey -algorithm RSA -out jwt.key -pkeyopt rsa_keygen_bits:2048
#   openssl rsa -in jwt.key -pubout -out jwt.key.pub
# Luego convertí los \n reales a literales \n para poner en una sola línea:
#   awk 'BEGIN{ORS="\\n"} {print}' jwt.key
JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# --- OpenAI ---
OPENAI_API_KEY=sk-...
LLM_SANDBOX=false
LLM_EMBEDDING_PROVIDER=openai
LLM_TEXT_PROVIDER=openai
EMBEDDING_DIMENSIONS=1536

# --- Gemini (opcional) ---
GOOGLE_AI_API_KEY=
