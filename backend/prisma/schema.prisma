generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  student
  recruiter
  admin
}

enum EvaluationStatus {
  pending
  processing
  completed
  failed
}

model User {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(255)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         UserRole @default(student)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  interviews         Interview[]
  skillScores        UserSkillScore[]
  recruiterNotes     RecruiterNote[]  @relation("RecruiterNotes")
  studentNotes       RecruiterNote[]  @relation("StudentNotes")
  auditLogs          AuditLog[]
  knowledgeDocuments KnowledgeDocument[]
  achievements             UserAchievement[]
  templates                InterviewTemplate[]
  challengeParticipations  ChallengeParticipation[]

  @@map("users")
}

model Role {
  id   Int    @id @default(autoincrement())
  name String @unique @db.VarChar(120)

  interviews     Interview[]
  roleLanguages  RoleLanguage[]
  templates      InterviewTemplate[]

  @@map("roles")
}

model Language {
  id   Int    @id @default(autoincrement())
  name String @unique @db.VarChar(120)

  frameworks         Framework[]
  questions          Question[]
  interviews         Interview[]
  roleLanguages      RoleLanguage[]
  knowledgeDocuments KnowledgeDocument[]
  templates          InterviewTemplate[]

  @@map("languages")
}

model RoleLanguage {
  roleId     Int @map("role_id")
  languageId Int @map("language_id")

  role     Role     @relation(fields: [roleId], references: [id])
  language Language @relation(fields: [languageId], references: [id])

  @@id([roleId, languageId])
  @@map("role_languages")
}

model Framework {
  id         Int    @id @default(autoincrement())
  name       String @db.VarChar(120)
  languageId Int    @map("language_id")

  language           Language            @relation(fields: [languageId], references: [id])
  questions          Question[]
  interviews         Interview[]
  knowledgeDocuments KnowledgeDocument[]
  templates          InterviewTemplate[]

  @@index([languageId])
  @@map("frameworks")
}

model Level {
  id   Int    @id @default(autoincrement())
  name String @unique @db.VarChar(120)

  questions         Question[]
  interviews        Interview[]
  answerEvaluations AnswerEvaluation[]
  templates         InterviewTemplate[]

  @@map("levels")
}

model Skill {
  id   Int    @id @default(autoincrement())
  name String @unique @db.VarChar(150)

  questions   Question[]
  skillScores UserSkillScore[]

  @@map("skills")
}

model Question {
  id           Int                              @id @default(autoincrement())
  questionText String                           @map("question_text")
  type         String                           @db.VarChar(80)
  source       String?                          @db.VarChar(120)
  languageId   Int                              @map("language_id")
  frameworkId  Int?                             @map("framework_id")
  levelId      Int                              @map("level_id")
  skillId      Int                              @map("skill_id")
  embedding    Unsupported("vector(1536)")?
  createdAt    DateTime                         @default(now()) @map("created_at") @db.Timestamptz()

  language           Language            @relation(fields: [languageId], references: [id])
  framework          Framework?          @relation(fields: [frameworkId], references: [id])
  level              Level               @relation(fields: [levelId], references: [id])
  skill              Skill               @relation(fields: [skillId], references: [id])
  interviewQuestions InterviewQuestion[]
  templateQuestions  TemplateQuestion[]

  @@index([languageId])
  @@index([frameworkId])
  @@index([levelId])
  @@index([skillId])
  @@map("questions")
}

model Interview {
  id                         Int              @id @default(autoincrement())
  userId                     Int              @map("user_id")
  roleId                     Int              @map("role_id")
  languageId                 Int?             @map("language_id")
  frameworkId                Int?             @map("framework_id")
  chosenLevelId              Int              @map("chosen_level_id")
  startedAt                  DateTime         @default(now()) @map("started_at") @db.Timestamptz()
  finishedAt                 DateTime?        @map("finished_at") @db.Timestamptz()
  evaluationStatus           EvaluationStatus @default(pending) @map("evaluation_status")
  evaluationNotificationSeen Boolean          @default(false) @map("evaluation_notification_seen")
  mode                       String           @default("evaluation") @db.VarChar(20)

  user      User        @relation(fields: [userId], references: [id])
  role      Role        @relation(fields: [roleId], references: [id])
  language  Language?   @relation(fields: [languageId], references: [id])
  framework Framework?  @relation(fields: [frameworkId], references: [id])
  level     Level       @relation(fields: [chosenLevelId], references: [id])
  questions InterviewQuestion[]

  @@index([userId])
  @@map("interviews")
}

model InterviewQuestion {
  // RNF-20: order_number aplica CHECK (> 0) a nivel de BD.
  // Constraint definida en migración 20260519120000_add_check_constraints.
  id                   Int     @id @default(autoincrement())
  interviewId          Int     @map("interview_id")
  questionId           Int     @map("question_id")
  questionTextSnapshot String  @map("question_text_snapshot")
  orderNumber          Int     @map("order_number")
  generatedByAi        Boolean @default(true) @map("generated_by_ai")

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  question  Question  @relation(fields: [questionId], references: [id])
  answers   Answer[]

  @@index([interviewId])
  @@map("interview_questions")
}

model Answer {
  id                  Int      @id @default(autoincrement())
  interviewQuestionId Int      @map("interview_question_id")
  answerText          String?  @map("answer_text")
  audioUrl            String?  @map("audio_url") @db.VarChar(500)
  answeredAt          DateTime @default(now()) @map("answered_at") @db.Timestamptz()

  interviewQuestion InterviewQuestion @relation(fields: [interviewQuestionId], references: [id], onDelete: Cascade)
  evaluation        AnswerEvaluation?

  @@index([interviewQuestionId])
  @@map("answers")
}

model AnswerEvaluation {
  // RNF-18: las 5 dimensiones aplican CHECK [0,5] a nivel de BD.
  // Constraints definidas en migración 20260519120000_add_check_constraints.
  id                   Int      @id @default(autoincrement())
  answerId             Int      @unique @map("answer_id")
  technicalCorrectness Float?   @map("technical_correctness") @db.Real
  clarityOfExplanation Float?   @map("clarity_of_explanation") @db.Real
  communication        Float?   @db.Real
  confidence           Float?   @db.Real
  problemSolving       Float?   @map("problem_solving") @db.Real
  detectedLevelId      Int?     @map("detected_level_id")
  feedbackText         String?  @map("feedback_text")
  juniorAnswer         String?  @map("junior_answer")
  midAnswer            String?  @map("mid_answer")
  seniorAnswer         String?  @map("senior_answer")
  evaluatedAt          DateTime @default(now()) @map("evaluated_at") @db.Timestamptz()

  answer        Answer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  detectedLevel Level? @relation(fields: [detectedLevelId], references: [id])

  @@index([answerId])
  @@map("answer_evaluations")
}

model UserSkillScore {
  // RNF-19: score aplica CHECK [0,100] a nivel de BD.
  // Constraint definida en migración 20260519120000_add_check_constraints.
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  skillId     Int      @map("skill_id")
  score       Float    @db.Real
  lastUpdated DateTime @default(now()) @map("last_updated") @db.Timestamptz()

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id])

  @@unique([userId, skillId])
  @@index([userId])
  @@map("user_skill_scores")
}

model RecruiterNote {
  id          Int      @id @default(autoincrement())
  recruiterId Int      @map("recruiter_id")
  studentId   Int      @map("student_id")
  interviewId Int?     @map("interview_id")
  content     String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  recruiter User @relation("RecruiterNotes", fields: [recruiterId], references: [id])
  student   User @relation("StudentNotes", fields: [studentId], references: [id])

  @@map("recruiter_notes")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  action    String   @db.VarChar(100)
  entity    String   @db.VarChar(100)
  entityId  Int?     @map("entity_id")
  details   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model KnowledgeDocument {
  id           Int      @id @default(autoincrement())
  title        String   @db.VarChar(500)
  sourceUrl    String?  @map("source_url") @db.VarChar(1000)
  rawContent   String   @map("raw_content")
  languageId   Int?     @map("language_id")
  frameworkId  Int?     @map("framework_id")
  uploadedById Int      @map("uploaded_by_id")
  status       String   @default("pending") @db.VarChar(30)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  language   Language?  @relation(fields: [languageId], references: [id])
  framework  Framework? @relation(fields: [frameworkId], references: [id])
  uploadedBy User       @relation(fields: [uploadedById], references: [id])
  chunks     KnowledgeChunk[]

  @@index([languageId])
  @@index([frameworkId])
  @@index([uploadedById])
  @@index([status])
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id         Int                           @id @default(autoincrement())
  documentId Int                           @map("document_id")
  chunkIndex Int                           @map("chunk_index")
  content    String
  tokenCount Int                           @map("token_count")
  embedding  Unsupported("vector(1536)")?
  createdAt  DateTime                      @default(now()) @map("created_at") @db.Timestamptz()

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("knowledge_chunks")
}

model Achievement {
  id            Int      @id @default(autoincrement())
  key           String   @unique @db.VarChar(100)
  title         String   @db.VarChar(200)
  titleEn       String   @map("title_en") @db.VarChar(200)
  description   String   @db.VarChar(500)
  descriptionEn String   @map("description_en") @db.VarChar(500)
  icon          String   @db.VarChar(50)
  category      String   @db.VarChar(50)
  threshold     Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  userAchievements UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  achievementId Int      @map("achievement_id")
  unlockedAt    DateTime @default(now()) @map("unlocked_at") @db.Timestamptz()

  user        User        @relation(fields: [userId], references: [id])
  achievement Achievement @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

model InterviewTemplate {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(200)
  description  String   @db.VarChar(500)
  companyType  String   @map("company_type") @db.VarChar(100)
  roleId       Int      @map("role_id")
  levelId      Int      @map("level_id")
  languageId   Int?     @map("language_id")
  frameworkId  Int?     @map("framework_id")
  isPublic     Boolean  @default(false) @map("is_public")
  createdById  Int      @map("created_by_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  role         Role      @relation(fields: [roleId], references: [id])
  level        Level     @relation(fields: [levelId], references: [id])
  language     Language? @relation(fields: [languageId], references: [id])
  framework    Framework? @relation(fields: [frameworkId], references: [id])
  createdBy    User      @relation(fields: [createdById], references: [id])
  questions    TemplateQuestion[]

  @@index([createdById])
  @@index([isPublic])
  @@map("interview_templates")
}

model TemplateQuestion {
  id         Int   @id @default(autoincrement())
  templateId Int   @map("template_id")
  questionId Int   @map("question_id")
  orderNumber Int  @map("order_number")

  template   InterviewTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id])

  @@index([templateId])
  @@map("template_questions")
}

model Challenge {
  id            Int      @id @default(autoincrement())
  title         String   @db.VarChar(200)
  titleEn       String   @map("title_en") @db.VarChar(200)
  description   String   @db.VarChar(500)
  descriptionEn String   @map("description_en") @db.VarChar(500)
  type          String   @db.VarChar(50)
  target        Int
  metric        String   @db.VarChar(100)
  icon          String   @db.VarChar(50)
  startDate     DateTime @map("start_date") @db.Timestamptz()
  endDate       DateTime @map("end_date") @db.Timestamptz()
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  participants ChallengeParticipation[]

  @@index([isActive])
  @@index([endDate])
  @@map("challenges")
}

model ChallengeParticipation {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  challengeId Int       @map("challenge_id")
  progress    Int       @default(0)
  completed   Boolean   @default(false)
  completedAt DateTime? @map("completed_at") @db.Timestamptz()
  joinedAt    DateTime  @default(now()) @map("joined_at") @db.Timestamptz()

  user      User      @relation(fields: [userId], references: [id])
  challenge Challenge @relation(fields: [challengeId], references: [id])

  @@unique([userId, challengeId])
  @@map("challenge_participations")
}
