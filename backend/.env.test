# Variables de entorno para la suite de integración (Fase 3 — QA).
# La cargan: backend/test/integration/setup.ts y el config de Jest de
# integración. NO compartir credenciales reales aquí — todas las claves
# son DE PRUEBA.

DATABASE_URL=postgresql://vinki:vinki_test@localhost:5434/vinki_test?schema=public
REDIS_URL=redis://localhost:6381

# JWT — par RSA 2048 de PRUEBA (NO usar en producción ni en desarrollo).
# El algoritmo configurado en auth.module.ts es RS256, que requiere claves
# asimétricas en formato PEM. Las nuevas líneas se almacenan como literal
# `\n` y el código en `auth.module.ts` / `jwt-cookie.strategy.ts` las
# convierte a saltos reales con `.replace(/\\n/g, '\n')`.
