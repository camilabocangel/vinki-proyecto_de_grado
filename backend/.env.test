JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Sandbox del LLM activado: las pruebas usan MockEvaluatorService y
# MockEmbeddingService — cero llamadas reales a OpenAI / Gemini.
LLM_SANDBOX=true
LLM_EMBEDDING_PROVIDER=mock
LLM_TEXT_PROVIDER=mock
OPENAI_API_KEY=mock-key
EMBEDDING_DIMENSIONS=1536

# S3 / MinIO — opcional para la suite de integración (audio no se sube).
AWS_S3_BUCKET=vinki-audio-test
AWS_REGION=us-east-1

NODE_ENV=test
PORT=3002
FRONTEND_URL=http://localhost:5174

# ThrottlerModule (D-14) — límites elevados para permitir las corridas
# de carga con JMeter (Fase 5, RNF-03: ≥ 50 usuarios concurrentes
# desde 127.0.0.1). Los defaults productivos siguen siendo 100/60s
# short y 300/60s long; aquí los desactivamos efectivamente.
THROTTLE_SHORT_LIMIT=100000
THROTTLE_SHORT_TTL=60000
THROTTLE_LONG_LIMIT=300000
THROTTLE_LONG_TTL=60000
