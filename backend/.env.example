# Database
DATABASE_URL="postgresql://vinki:vinki_dev@localhost:5433/vinki?schema=public"

# Redis
REDIS_URL="redis://localhost:6380"

# JWT (RS256) - Generate with: ssh-keygen -t rsa -b 2048 -m PEM -f jwt.key
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# OpenAI
OPENAI_API_KEY="sk-..."
LLM_SANDBOX="true"

# S3 / MinIO
AWS_S3_BUCKET="vinki-audio"
AWS_S3_ENDPOINT="http://localhost:9000"
AWS_S3_ACCESS_KEY="minioadmin"
AWS_S3_SECRET_KEY="minioadmin"
AWS_REGION="us-east-1"

# App
NODE_ENV="development"
PORT=3000
FRONTEND_URL="http://localhost:5173"

# SMTP (email notifications)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
