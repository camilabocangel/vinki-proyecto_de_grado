# ============================================
# Vinki Backend — Variables de Entorno
# ============================================
# Copia este archivo como .env y completa los valores
# cp .env.example .env

# --- Database ---
# Para Docker: postgresql://vinki:vinki_dev@localhost:5433/vinki?schema=public
# Para local sin Docker: postgresql://vinki:vinki_dev@localhost:5432/vinki?schema=public
DATABASE_URL="postgresql://vinki:vinki_dev@localhost:5433/vinki?schema=public"

# --- Redis ---
# Para Docker: redis://localhost:6380
# Para local sin Docker: redis://localhost:6379
REDIS_URL="redis://localhost:6380"

# --- JWT (RS256) ---
# Genera tus claves con: openssl genpkey -algorithm RSA -out jwt.key -pkeyopt rsa_keygen_bits:2048
# Luego: openssl rsa -pubout -in jwt.key -out jwt.pub
# Pega el contenido reemplazando saltos de línea con \n
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# --- OpenAI ---
# Obtén tu key en: https://platform.openai.com/api-keys
# LLM_SANDBOX=true usa respuestas simuladas (no consume API)
# LLM_SANDBOX=false usa gpt-4o-mini real
OPENAI_API_KEY="sk-..."
LLM_SANDBOX="true"

# --- S3 / MinIO (almacenamiento de audio) ---
AWS_S3_BUCKET="vinki-audio"
AWS_S3_ENDPOINT="http://localhost:9000"
AWS_S3_ACCESS_KEY="minioadmin"
AWS_S3_SECRET_KEY="minioadmin"
AWS_REGION="us-east-1"

# --- App ---
NODE_ENV="development"
PORT=3000
FRONTEND_URL="http://localhost:5174"

# --- SMTP (notificaciones email, opcional) ---
# Dejar vacío para deshabilitar emails
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
