# Database
DATABASE_URL="postgresql://vinki:vinki_dev@localhost:5433/vinki?schema=public"

# Redis
REDIS_URL="redis://localhost:6380"

# JWT (RS256) - Generate with: ssh-keygen -t rsa -b 2048 -m PEM -f jwt.key
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# OpenAI
OPENAI_API_KEY="sk-..."
LLM_SANDBOX="true"

# S3 / MinIO
AWS_S3_BUCKET="vinki-audio"
AWS_S3_ENDPOINT="http://localhost:9000"
AWS_S3_ACCESS_KEY="minioadmin"
AWS_S3_SECRET_KEY="minioadmin"
AWS_REGION="us-east-1"

# App
NODE_ENV="development"
PORT=3000
FRONTEND_URL="http://localhost:5173"

# ThrottlerModule (rate limiting por IP). Opcionales: si no se setean,
# se usan los defaults productivos (100 req/60s short, 300 req/60s long).
# Las pruebas de carga (Fase 5 — JMeter) elevan estos límites a valores
# altos en backend/.env.test para no disparar 429 con 50 usuarios
# concurrentes desde 127.0.0.1. Ver Decisión D-14 en
# qa/01-plan-maestro/decisiones_qa.md.
# THROTTLE_SHORT_LIMIT=100
# THROTTLE_SHORT_TTL=60000
# THROTTLE_LONG_LIMIT=300
# THROTTLE_LONG_TTL=60000

# Gmail API (notificaciones por correo vía OAuth2)
# Si alguna de estas variables está vacía, las notificaciones por correo
# se deshabilitan silenciosamente (no rompe la app).
# Ver guía: Google Cloud Console → APIs & Services → Gmail API.
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""
GMAIL_SENDER_EMAIL=""
