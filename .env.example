# ============================================
# Vinki — Variables de Entorno (raíz)
# ============================================
# Estas variables son leídas por docker-compose.yml
# Copia este archivo como .env y completa los valores
# cp .env.example .env

# --- JWT Keys ---
# Genera con: openssl genpkey -algorithm RSA -out jwt.key -pkeyopt rsa_keygen_bits:2048
# Pega el contenido con \n en lugar de saltos de línea
JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

# --- OpenAI ---
OPENAI_API_KEY=sk-...
LLM_SANDBOX=false
